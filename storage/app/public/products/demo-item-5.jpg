<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 320 320" width="320" height="320">
    <defs>
        <radialGradient id="cardGlow" cx="50%" cy="50%" r="50%">
            <stop offset="0%" stop-color="#1E40AF" stop-opacity="0.12"/>
            <stop offset="100%" stop-color="#F8FAFC" stop-opacity="0"/>
        </radialGradient>
        <filter id="pShadow" x="-20%" y="-20%" width="140%" height="140%">
            <feDropShadow dx="0" dy="8" stdDeviation="10" flood-color="#0F172A" flood-opacity="0.12"/>
        </filter>
    </defs>
    <rect width="320" height="320" rx="24" fill="#FFFFFF"/>
    <circle cx="160" cy="150" r="120" fill="url(#cardGlow)"/>
    
    <!-- Top Brand/Category Pill -->
    <rect x="20" y="16" width="100" height="22" rx="11" fill="#1E40AF" fill-opacity="0.1"/>
    <text x="70" y="31" font-family="'Plus Jakarta Sans', sans-serif" font-size="9" font-weight="900" fill="#1E40AF" text-anchor="middle">LAPTOPS</text>

    <!-- Center Product Vector Illustration -->
    <g filter="url(#pShadow)" transform="translate(160, 150)">
            <g transform="translate(-65, -50)">
        <rect x="15" y="0" width="100" height="68" rx="6" fill="#0F172A" stroke="#2563EB" stroke-width="3.5"/>
        <rect x="21" y="6" width="88" height="56" rx="3" fill="#1E293B"/>
        <text x="65" y="38" font-family="'Plus Jakarta Sans', sans-serif" font-size="11" font-weight="900" fill="#38BDF8" text-anchor="middle">CORE i5 / M2</text>
        <path d="M0 68 H130 L120 84 H10 Z" fill="#E2E8F0" stroke="#2563EB" stroke-width="3"/>
        <line x1="55" y1="74" x2="75" y2="74" stroke="#94A3B8" stroke-width="2.5" stroke-linecap="round"/>
    </g>
    </g>

    <!-- Bottom ALLZONE watermark -->
    <text x="160" y="300" font-family="'Plus Jakarta Sans', sans-serif" font-size="10" font-weight="800" fill="#94A3B8" letter-spacing="1.5" text-anchor="middle">ALLZONE OFFICIAL DIRECT</text>
</svg>