APP_NAME=ALLZONE
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Kolkata
APP_URL=http://localhost:8000
APP_CURRENCY=INR

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_IN

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=allzone
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public

QUEUE_CONNECTION=database

CACHE_STORE=failover

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@allzone.in"
MAIL_FROM_NAME="${APP_NAME}"

ALLZONE_COMPANY_NAME="SK Refrigeration"
ALLZONE_DEFAULT_COMMISSION_PCT=10.00
ALLZONE_DEFAULT_DELIVERY_RADIUS_KM=8.00
ALLZONE_ORDER_PREFIX=AZ-
ALLZONE_CARGO_PREFIX=AZL-
ALLZONE_CURRENCY=INR
ALLZONE_CURRENCY_SYMBOL=₹

# Razorpay Payment Gateway (Production / Sandbox)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Cashfree Payment Gateway (Optional Backup)
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_API_VERSION=2023-08-01
CASHFREE_ENVIRONMENT=production

# Shiprocket Logistics Integration
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_API_KEY=
SHIPROCKET_BASE_URL=https://apiv2.shiprocket.in/v1/external
SHIPROCKET_FAKE=false
SHIPROCKET_ENABLED=true

# Firebase Cloud Messaging (Push Notifications)
FIREBASE_CREDENTIALS=
FCM_SERVER_KEY=

HORIZON_ENABLED=false
