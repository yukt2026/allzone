<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 320 320" width="320" height="320">
    <defs>
        <radialGradient id="cardGlow" cx="50%" cy="50%" r="50%">
            <stop offset="0%" stop-color="#06B6D4" stop-opacity="0.12"/>
            <stop offset="100%" stop-color="#F8FAFC" stop-opacity="0"/>
        </radialGradient>
        <filter id="pShadow" x="-20%" y="-20%" width="140%" height="140%">
            <feDropShadow dx="0" dy="8" stdDeviation="10" flood-color="#0F172A" flood-opacity="0.12"/>
        </filter>
    </defs>
    <rect width="320" height="320" rx="24" fill="#FFFFFF"/>
    <circle cx="160" cy="150" r="120" fill="url(#cardGlow)"/>
    
    <!-- Top Brand/Category Pill -->
    <rect x="20" y="16" width="100" height="22" rx="11" fill="#06B6D4" fill-opacity="0.1"/>
    <text x="70" y="31" font-family="'Plus Jakarta Sans', sans-serif" font-size="9" font-weight="900" fill="#06B6D4" text-anchor="middle">COOLING SOLUTIONS</text>

    <!-- Center Product Vector Illustration -->
    <g filter="url(#pShadow)" transform="translate(160, 150)">
            <g transform="translate(-65, -45)">
        <rect x="0" y="0" width="130" height="55" rx="10" fill="#F8FAFC" stroke="#0284C7" stroke-width="4"/>
        <line x1="10" y1="42" x2="120" y2="42" stroke="#0284C7" stroke-width="3"/>
        <circle cx="115" cy="18" r="4" fill="#22C55E"/>
        <text x="25" y="22" font-family="sans-serif" font-size="9" font-weight="900" fill="#0284C7">INVERTER</text>
        <path d="M20 70 Q65 58 110 70" stroke="#38BDF8" stroke-width="3" fill="none" stroke-linecap="round"/>
        <path d="M30 82 Q65 72 100 82" stroke="#06B6D4" stroke-width="2.5" fill="none" stroke-linecap="round"/>
    </g>
    </g>

    <!-- Bottom ALLZONE watermark -->
    <text x="160" y="300" font-family="'Plus Jakarta Sans', sans-serif" font-size="10" font-weight="800" fill="#94A3B8" letter-spacing="1.5" text-anchor="middle">ALLZONE OFFICIAL DIRECT</text>
</svg>